# =====================================================================
# TRAUMANET ENVIRONMENT CONFIGURATION
# =====================================================================

# Google Gemini API Key for Multimodal Vision & Clinical Triage
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform API Key (Optional for live geocoding & directions)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key_here

# Firebase / Firestore Config (Optional: If using managed Firebase instead of built-in reactive store)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
